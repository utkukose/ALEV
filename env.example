# ALEV v2 — Ortam Değişkenleri
# Bu dosyayı .env olarak kopyalayın ve değerleri doldurun:
# cp .env.example .env

# Admin panel girişi
ADMIN_USERNAME=admin
ADMIN_PASSWORD=guclu-bir-sifre-girin

# JWT imzalama anahtarı (en az 32 karakter, rastgele üretin)
SECRET_KEY=buraya-cok-guclu-rastgele-bir-anahtar-girin

# Bot token şifreleme anahtarı (boş bırakılabilir ama üretim için doldurun)
TOKEN_ENCRYPTION_KEY=

# İç servis güvenlik anahtarı (bot_handler → webhook iletişimi)
INTERNAL_SECRET=buraya-rastgele-bir-deger-girin
